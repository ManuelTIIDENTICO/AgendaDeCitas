@{
    ViewBag.Title = "Services";
    string clinicID = ViewBag.ClinicID as string;
    var services = Model as Dictionary<string, string>; // Dictionary with ServiceDescription as key and ServiceID as value
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css"> <!-- Include AOS CSS -->

    <title>Services</title>
    <style>
        h1 {
            font-family: 'Nunito Sans', sans-serif;
            color: #E7307D;
            text-align: left;
            margin-bottom: 20px;
            font-size: 25px;
        }

        h4 {
            font-family: 'Nunito Sans', sans-serif;
            color: #000;
            font-size: 20px;
        }

        .service-option {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 10px 0;
            padding: 10px 20px;
            background-color: #ffffff;
            border: 1px solid #000;
            border-radius: 15px;
            color: #000000;
            text-decoration: none;
            text-align: left;
            opacity: 0; /* Initial opacity for AOS */
            transition: opacity 0.5s ease-in-out; /* Smooth transition */
        }

            .service-option:hover {
                border-color: #E7307D;
            }

        .service-label {
            margin-left: 10px;
        }

        .service-checkbox {
            width: 20px;
            height: 20px;
            margin: 0;
            -webkit-appearance: none;
            appearance: none;
            border: 2px solid #cc0177;
            border-radius: 50%;
            outline: none;
            cursor: pointer;
            background-color: #fff;
            position: relative;
        }

            .service-checkbox:checked {
                background-color: #cc0177;
                border-color: #cc0177;
            }

                .service-checkbox:checked::before {
                    content: '✓'; /* Checkmark character */
                    display: block;
                    color: white;
                    font-weight: bold;
                    text-align: center;
                    line-height: 16px; /* Center the checkmark */
                    font-size: 16px;
                }

        .btn-next {
            background-color: #E7307D;
            border-style: solid;
            color: white;
            width: calc(100% - 20px);
            margin: 10px;
            padding: 10px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: x-large;
            position: fixed;
            bottom: 0;
            left: 0;
            z-index: 1000;
            display: none; /* Initially hidden */
        }
    </style>
</head>
<body>
    <h1>¿Qué zonas quieres depilarte?</h1>

    <form action="/calendar/selectdate/" method="post" id="servicesForm">
        <input type="hidden" name="clinicID" value="@clinicID" />
        <input type="hidden" name="serviceIDs" id="serviceIDs" value="" />

        @if (services != null && services.Count > 0)
        {
            foreach (var service in services)
            {
                <div class="service-option" data-aos="fade-up" data-aos-duration="1000">
                    <h4><label for="service@services.Keys.ToList().IndexOf(service.Key)" class="service-label">@service.Key</label></h4>
                    <input type="checkbox" class="service-checkbox" id="service@services.Keys.ToList().IndexOf(service.Key)" value="@service.Value" />
                </div>
            }
        }

        <button class="btn-next" id="continueButton" type="button" onclick="submitForm()">Continuar <i class="fa fa-arrow-right" style="margin-left: auto;"></i></button>
    </form>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script> <!-- Include AOS JavaScript -->
    <script>
        AOS.init(); // Initialize AOS

        function toggleContinueButton() {
            const checkboxes = document.querySelectorAll('.service-checkbox');
            const continueButton = document.getElementById('continueButton');
            let anyChecked = false;

            checkboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    anyChecked = true;
                }
            });

            continueButton.style.display = anyChecked ? 'flex' : 'none';
        }

        function submitForm() {
            const selectedServices = [];
            const checkboxes = document.querySelectorAll('.service-checkbox:checked');
            checkboxes.forEach(checkbox => {
                selectedServices.push(checkbox.value);
            });

            const serviceIDs = selectedServices.join(',');
            const clinicID = document.querySelector('input[name="clinicID"]').value;

            const url = `/calendar/selectdate?clinicID=${encodeURIComponent(clinicID)}&serviceIDs=${encodeURIComponent(serviceIDs)}`;
            window.location.href = url;
        }

        // Attach event listeners to checkboxes
        document.querySelectorAll('.service-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', toggleContinueButton);
        });

        // Initial check on page load
        toggleContinueButton();
    </script>
</body>
</html>
