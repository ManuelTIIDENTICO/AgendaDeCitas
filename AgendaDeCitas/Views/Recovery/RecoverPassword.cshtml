@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<h2>¿No recuerdas tu contraseña ? </h2>

<div class="text-test">
    No te preocupes,nos sucede a todos, ingresa tu email y te ayudaremos.
</div>

<br />

<!-- Muestra un mensaje de confirmación o error -->
@if (!string.IsNullOrEmpty(ViewBag.Message))
{
    <div class="custom-alert">@ViewBag.Message</div>
}
<style>
    .input-group {
        border: 1px solid #ccc;
        border-radius: 30px;
        overflow: hidden;
        margin-bottom: 15px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Efecto de sombra */
        transition: box-shadow 0.3s ease; /* Transición suave para el efecto de sombra */
    }

        .input-group .form-control:focus {
            box-shadow: none; /* Elimina la sombra al enfocar */
            outline: none; /* Elimina el borde de enfoque predeterminado del navegador */
        }

    .form-control {
        border: none;
        border-radius: 0 30px 30px 0;
        font-size: 16px;
        font-family: 'Nunito Sans', sans-serif;
        margin-top: 10px;
        margin-bottom: 10px;
    }

    .input-group-text {
        background-color: #fff;
        border-color: #ccc;
        border-right: none;
        border-top: none;
        border-bottom: none;
        color: #d3d3d3;
    }

    .icon-active {
        color: #E7307D;
    }

    .btn-custom-color {
        background-color: #d4cccd;
        color: white;
        border-radius: 30px;
        border: none;
        padding: 10px;
        font-size: 20px;
        font-family: 'Nunito Sans', sans-serif;
        margin-top: 10px;
        margin-bottom: 10px;
    }

        .btn-custom-color:hover {
            background-color: #E7307D;
        }

    .w-100 {
        width: 100%;
    }
    h2 {
        font-family: 'Nunito Sans', sans-serif;
        color: #E7307D;
        font-size: 24px;
        font-weight: bold; /* Aplica negrita al texto */
        text-align: center;
    }

    .text-test {
        font-family: 'Nunito Sans', sans-serif;
        text-align: center; /* Para centrar el texto si es necesario */
        font-size: 18px;
        color: #000;
    }
    /* Estilos personalizados */
    .text-link {
        font-family: 'Nunito Sans', sans-serif;
        text-align: center; /* Para centrar el texto si es necesario */
        font-size: 18px;
    }

        .text-link a {
            color: #E7307D; /* Cambia el color del texto del enlace */
            text-decoration: none; /* Elimina el subrayado si es necesario */
        }

            .text-link a:hover {
                text-decoration: underline; /* Opcional: agrega un subrayado al pasar el mouse sobre el enlace */
            }

    

    .text-center {
        font-family: 'Nunito Sans', sans-serif;
        text-align: center; /* Para centrar el texto si es necesario */
        font-size: 16px;
        font-weight: bold; /* Aplica negrita al texto */
    }

    .input-group {
        border: 1px solid #ccc; /* Borde gris para el conjunto de entrada */
        border-radius: 30px;
        overflow: hidden; /* Asegura que los bordes redondeados se apliquen correctamente */
    }

    .custom-alert {
        background-color: #E7307D;
        color: white;
        font-family: 'Nunito Sans', sans-serif;
        text-align: center;
        font-size: 16px;
        padding: 10px;
        border-radius: 5px;
        margin-top: 15px;
    }

    
</style>
<!-- Formulario para ingresar el correo electrónico -->
<form asp-action="RecoverPassword" method="post" class="mt-4">
    <div class="form-group">
        <div class="input-group">
            <span class="input-group-text"><i class="fa fa-envelope" id="emailIcon"></i></span>
            <input type="text" id="email" name="email" class="form-control rounded" placeholder="Email*" required />
        </div>
    </div>
    <button type="submit" class="btn btn-custom-color w-100">
        SOLICITAR <i class="fas fa-arrow-right fa-arrow-right-light"></i>
    </button>
    <br />
    <br />
     <br />

    <div class="text-center">
        ¿No tienes cuenta creada?
    </div>
    <div class="text-link">
        <a href="/user/Register"> Regístrate </a>
    </div>
    
</form>

