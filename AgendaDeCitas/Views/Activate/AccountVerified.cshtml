@{
    ViewBag.Title = "Cuenta Verificada";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css">
    <link rel="stylesheet" href="~/css/styles.css">
    <style>
        
        body {
            background-color: #fff;
            font-family: 'Nunito', sans-serif;
        }

        h1 {
            font-family: 'Nunito Sans', sans-serif;
            color: #E7307D;
            text-align: left;
            margin-bottom: 20px;
            font-size: 36px;
        }

        h3 {
            font-family: 'Nunito Sans', sans-serif;
            color: #000;
            font-size: 20px;
        }

        h4 {
            font-family: 'Nunito Sans', sans-serif;
            color: #000;
            font-size: 18px;
        }

        h5 {
            font-family: 'Nunito Sans', sans-serif;
            color: #000;
            font-size: 12px;
        }

        .btn-custom-color {
            background-color: #E7307D;
            color: white;
            border-radius: 30px;
            border: none;
            padding: 10px;
            font-size: 20px;
            font-family: 'Nunito Sans', sans-serif;
            margin-top: 10px;
            margin-bottom: 10px;
        }

            .btn-custom-color:hover {
                background-color: #E7307D;
                color: white;
            }

        .w-100 {
            width: 100%;
        }
    </style>
    
</head>
<h2>¡Hola @ViewBag.UserName!</h2>
<p>Tu cuenta ha sido verificada exitosamente.</p>
<a href="/Ciudades" class="btn btn-custom-color w-100">Empezar</a>
