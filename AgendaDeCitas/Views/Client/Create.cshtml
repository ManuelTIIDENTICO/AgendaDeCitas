@model ClientViewModel

@{
    ViewData["Title"] = "Crear Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<br />
<h5>Resumen de tu cita</h5>
<br />
<div class="card">
    <div id="appointmentSummary">
        
    </div>
</div>
<br />
<h1>Reserva tu cita</h1>

<style>
    body {
        background-color: #fef9fb;
    }

    form {
        border-radius: 20px;
    }

    h1 {
        font-family: 'Nunito Sans', sans-serif;
        color: #E7307D;
        text-align: left;
        margin-bottom: 20px;
        font-size: 25px;
    }



    h3 {
        font-family: 'Nunito Sans', sans-serif;
        color: #000;
        font-size: 15px;
    }

    h5 {
        font-family: 'Nunito Sans', sans-serif;
        color: #000;
        font-size: 18px;
        font-weight: bold;
        
    }

    h4 {
        font-family: 'Nunito Sans', sans-serif;
        color: #000;
        font-size: 18px;
        
    }

    .card {
        border-color: #E7307D;
        border-radius: 20px;
        padding: 20px;
    }

    .card-header {
        background-color: #ffffff;
        color: #000;
        border-radius: 15px;
        border-color: #000;
        margin-bottom: 5px;
        padding: 5px;
    }

        .card-header h2 {
            margin-bottom: 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-header .btn-link-custom {
            width: 100%;
        }

    .accordion {
        border: 1px solid #000;
        border-radius: 10px;
    }

    .input-container {
        position: relative;
        margin-bottom: 15px;
    }

        .input-container input {
            border: 1px solid #6d3969;
            padding: 10px 10px 10px 15px;
            width: 100%;
            border-radius: 15px;
        }

        .input-container .check-icon {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            color: green;
            display: none;
        }

    .radio-button {
        display: none;
    }

        .radio-button + label {
            display: inline-block;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background-color: #e7307d;
            margin-left: 10px;
            cursor: pointer;
            position: relative;
        }

        .radio-button:checked + label::after {
            content: '\f00c';
            font-family: 'FontAwesome';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
        }

    .service-checkbox {
        width: 20px;
        height: 20px;
        margin: 0;
        -webkit-appearance: none;
        appearance: none;
        border: 2px solid #cc0177;
        border-radius: 50%;
        outline: none;
        cursor: pointer;
        background-color: #fff;
        position: relative;
    }

        .service-checkbox:checked {
            background-color: #cc0177;
            border-color: #cc0177;
        }

            .service-checkbox:checked::before {
                content: '✓'; /* Carácter del check */
                display: block;
                color: white;
                font-weight: bold;
                text-align: center;
                line-height: 16px; /* Ajustar para centrar el check */
                font-size: 16px;
            }

    .checkbox-container {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

        .checkbox-container h5 {
            margin: 0 0 0 10px;
        }

    .icon {
        margin-right: 10px;
        font-size: 1.5em; /* Tamaño del ícono */
        color: #E7307D; /* Color del ícono */
    }

    .icon-light {
        color: #333; /* Color más suave para íconos ligeros */
    }

    .icon-small {
        font-size: 1.2em; /* Tamaño más pequeño para íconos */
    }
</style>

<form asp-action="Create" method="post">
    <div class="input-container">
        <input asp-for="Nombres" placeholder="Nombres" value="@ViewBag.Nombres" class="form-control" style="border-radius:30px;padding-top: 15px;padding-bottom: 15px;" />
        <i class="fa fa-check check-icon"></i>
        <span asp-validation-for="Nombres" class="text-danger" style="display: block; margin-top: 5px;"></span>
    </div>
    <div class="input-container">
        <input asp-for="Primer_Apellido" placeholder="Primer Apellido" value="@ViewBag.Apellidos" class="form-control" style="border-radius:30px;padding-top: 15px;padding-bottom: 15px;" />
        <i class="fa fa-check check-icon"></i>
        <span asp-validation-for="Primer_Apellido" class="text-danger"  style="display: block; margin-top: 5px;"></span>
    </div>
    <div class="input-container">
        <input asp-for="ClientSurname2" placeholder="Segundo Apellido" style="border-radius:30px;padding-top: 15px;padding-bottom: 15px;" class="form-control" />
        <i class="fa fa-check check-icon"></i>
        <span asp-validation-for="ClientSurname2" class="text-danger" style="display: block; margin-top: 5px;"></span>
    </div>
    <div class="input-container">
        <input asp-for="ClientPhone1" placeholder="Teléfono" value="@ViewBag.Telefono" style="border-radius:30px;padding-top: 15px;padding-bottom: 15px;" class="form-control" />
        <i class="fa fa-check check-icon"></i>
        <span asp-validation-for="ClientPhone1" class="text-danger" style="display: block; margin-top: 5px;"></span>
    </div>
    <div class="input-container">
        <input asp-for="ClientEmail" placeholder="Email" value="@ViewBag.Email" style="border-radius:30px;padding-top: 15px;padding-bottom: 15px;" class="form-control" />
        <i class="fa fa-check check-icon"></i>
        <span asp-validation-for="ClientEmail" class="text-danger" style="display: block; margin-top: 5px;"></span>
    </div>
    <div class="checkbox-container">
        <input type="checkbox" class="service-checkbox" />
        <h4>&nbsp;  Acepto los <a href="https://sinvelloporlaser.es/politica-de-privacidad/" style="color:#e7307d" target="_blank">términos y condiciones</a> </h4>
    </div>
    <div class="checkbox-container">
        <input type="checkbox" class="service-checkbox" />
        <h4>&nbsp;  Quiero que me informes de vuestras ofertas</h4>
    </div>

    <button type="submit" class="btn btn-primary" style="background-color: #e7307d; color: white; padding: 10px 20px; border: none; border-radius: 5px; width: 100%;">Continuar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Function to extract query parameters from URL
        function getQueryParam(param) {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get(param);
        }

        // Function to get the name of the day
        // Función para obtener el nombre del día correctamente
        function getDayName(dateStr) {
            const [year, month, day] = dateStr.split('-'); // Extrae año, mes, día
            const date = new Date(year, month - 1, day); // Crea el objeto Date usando los componentes de fecha (mes en base 0)
            const options = { weekday: 'long' };
            return date.toLocaleDateString('es-ES', options); // Formatea usando el locale 'es-ES' para obtener el nombre del día en español
        }

        // Resto del código...


        // Function to calculate the difference in minutes between two times
        function getTimeDifferenceInMinutes(startTimeStr, endTimeStr) {
            const startTime = new Date(`1970-01-01T${startTimeStr}:00`);
            const endTime = new Date(`1970-01-01T${endTimeStr}:00`);
            const diffMs = endTime - startTime;
            return Math.floor(diffMs / (1000 * 60));
        }
        function formatDateToSpanish(dateString) {
            // Use the format YYYY-MM-DDTHH:mm:ss to avoid timezone issues
            const date = new Date(dateString + 'T00:00:00');

            const day = date.getDate();
            const month = date.toLocaleString('es-ES', { month: 'long' }); // Get the month name in Spanish
            const year = date.getFullYear();

            // Capitalize the first letter of the month name
            const formattedMonth = month.charAt(0).toUpperCase() + month.slice(1);

            return `${day} de ${formattedMonth} de ${year}`;
        }

        // Example usage:
        console.log(formatDateToSpanish('2024-08-21'));


        // Display appointment summary
        function capitalizeFirstLetter(string) {
            if (!string) return string;
            return string.charAt(0).toUpperCase() + string.slice(1);
        }
        function displayAppointmentSummary() {
            const date = getQueryParam('date');
            const timeStart = getQueryParam('timeStart');
            const timeEnd = getQueryParam('timeEnd');
            const clinicAddress = '@ViewBag.ClinicAddress';

            const summaryDiv = document.getElementById('appointmentSummary');
            if (date && timeStart && timeEnd) {
                const dayName = capitalizeFirstLetter(getDayName(date));
                const durationMinutes = getTimeDifferenceInMinutes(timeStart, timeEnd);
                const dateformat = formatDateToSpanish(date);
                summaryDiv.innerHTML = `
            <h3><i class="fa fa-calendar-days icon icon-light"></i> ${dayName}, ${dateformat}</h3>
            <h3><i class="fa fa-map-marker-alt icon icon-light"></i>${clinicAddress}</h3>
            <h3><i class="fa fa-clock icon icon-light"></i> ${durationMinutes} minutos</h3>
                        `;
            } else {
                summaryDiv.innerHTML = '<p>No se encontraron detalles de la cita.</p>';
            }
        }

        // Run the function on page load
        displayAppointmentSummary();
    </script>
}
